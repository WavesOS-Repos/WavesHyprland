    urgent-background:           #ffece9;

    cursorcolor:                 #def3ff;

    color0:  #0a151a;
    color1:  #ffece9;
    color2:  #e6f1ff;
    color3:  #ebf0ff;
    color4:  #def3ff;
    color5:  #e6f1ff;
    color6:  #ebf0ff;
    color7:  #d9e4eb;
    color8:  #e7f2f9;
    color9:  #ffece9;
    color10: #e6f1ff;
    color11: #ebf0ff;
    color12: #def3ff;
    color13: #e6f1ff;
    color14: #ebf0ff;
    color15: #d9e4eb;
}
