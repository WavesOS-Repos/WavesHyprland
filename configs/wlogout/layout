
{
  "label": "lock",
  "action": "hyprlock",
  "text": "Lock",
  "keybind": "l"
}
{
  "label": "logout",
  "action": "hyprctl dispatch 'hl.dsp.exit()'",
  "text": "Logout",
  "keybind": "e"
}
{
  "label": "suspend",
  "action": "systemctl suspend",
  "text": "Sleep",
  "keybind": "s"
}
{
  "label": "hibernate",
  "action": "systemctl hibernate",
  "text": "Hibernate",
  "keybind": "h"
}
{
  "label": "reboot",
  "action": "systemctl reboot",
  "text": "Restart",
  "keybind": "r"
}
{
  "label": "shutdown",
  "action": "~/.config/hypr/scripts/shutdown-sound.sh",
  "text": "Shutdown",
  "keybind": "p"
}

